# Salin file ini menjadi .env lalu isi sesuai kebutuhan.

# Kosongkan = agent jalan di MODE OFFLINE (rule-based, gratis, tanpa internet).
# Isi = agent pakai Claude (lebih pintar & natural). Dapatkan di https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model Claude yang dipakai
CLAUDE_MODEL=claude-opus-5-5

# Port web simulator
PORT=3000

# (Opsional) URL webhook n8n kalau mau UI simulator meneruskan chat ke workflow n8n
# contoh: http://localhost:5678/webhook/gocare-wa
N8N_WEBHOOK_URL=

# Tingkat "berpikir" (low = cepat & hemat, medium = seimbang, high = paling teliti)
CLAUDE_EFFORT=medium

# ---- Saat di-hosting ----
# Password untuk membuka simulator (browser minta username bebas + password ini). WAJIB diisi saat online.
APP_PASSWORD=
# Maksimal pesan chat per IP per jam
RATE_LIMIT_PER_HOUR=60
